# Comma-separated CORS origins (default: http://localhost:5173,http://localhost:4173)
RECIPE_CORS_ORIGINS=

# Phase 3 — AI caption structuring (Claude Haiku 4.5)
ANTHROPIC_API_KEY=
# Monthly ceiling in cents; needs the Supabase vars below to be enforced (default 500 = $5)
AI_MONTHLY_BUDGET_CENTS=

# Optional. Salts the hash of the caller's IP used for the per-caller hourly cap
# on /extract and /structure. Any random string. Without it the cap still works;
# the hashes are just brute-forceable back to the address, which is the whole
# IPv4 space and not much work.
RATE_LIMIT_SALT=

# Phase 2 — Supabase (server-only; service role bypasses RLS, never expose)
# There is deliberately no SUPABASE_JWT_SECRET here. auth.py verifies a session by
# asking GoTrue who the token belongs to rather than checking a signature locally,
# so nothing reads that secret — and a documented variable no code consumes is an
# invitation to paste a real one somewhere it isn't needed.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Phase 7 — image mirroring. The anon key is what the backend presents as `apikey`
# when it asks GoTrue who a caller's access token belongs to; it is the same value
# the frontend already ships as VITE_SUPABASE_ANON_KEY and is safe to hold here.
# Uploads themselves use SUPABASE_SERVICE_ROLE_KEY above, so without that set the
# endpoint reports storage as unconfigured and imports simply keep the origin URL.
SUPABASE_ANON_KEY=
